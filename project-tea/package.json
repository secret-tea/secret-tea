{
  "name": "project-tea",
  "packageManager": "pnpm@7.33.0",
  "displayName": "Secret Tea",
  "publisher": "SecretTea",
  "description": "Scan your workspace for secrets!",
  "version": "0.0.28",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onDidChangeTextDocument",
    "onDidSaveTextDocument",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "project-tea-sidebar-view",
          "title": "Secret Tea",
          "icon": "media/secret_tea.svg"
        }
      ]
    },
    "views": {
      "project-tea-sidebar-view": [
        {
          "type": "webview",
          "id": "project-tea-sidebar",
          "name": "Secrets",
          "icon": "media/secret_tea.svg"
        },
        {
          "type": "webview",
          "id": "project-tea-malware-sidebar",
          "name": "Malware",
          "icon": "media/secret_tea.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "project-tea.scanMalware",
        "category": "Malware Tea",
        "title": "Malware Scan workspace"
      },
      {
        "command": "project-tea.scanCurrentWorkspace",
        "category": "Secret Tea",
        "title": "Scan workspace for secrets"
      },
      {
        "command": "project-tea.scanRepoHistory",
        "category": "Secret Tea",
        "title": "Scan git commit history"
      },
      {
        "command": "project-tea.showOutput",
        "category": "Secret Tea",
        "title": "Show output log"
      },
      {
        "command": "project-tea.sidebar.refresh",
        "category": "Secret Tea",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "project-tea.toggleMasking",
        "category": "Secret Tea",
        "title": "Toggle Visual Masking"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "project-tea.sidebar.refresh",
          "when": "view == project-tea-sidebar",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:webview && npm run copy-templates",
    "compile:extension": "tsc -p ./",
    "compile:webview": "tsc -p ./tsconfig.webview.json",
    "copy-templates": "mkdir -p out/templates && cp src/templates/*.html out/templates/",
    "watch": "npm run watch:extension & npm run watch:webview",
    "watch:extension": "tsc -watch -p ./",
    "watch:webview": "tsc -watch -p ./tsconfig.webview.json",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "setup:sample": "bash scripts/setup-sample-workspace.sh",
    "test:vscode": "npm run setup:sample && vscode-test",
    "test:gitleaks": "jest src/test2/suite/gitleaks.test.ts --testMatch=\"**/*.test.ts\"",
    "report:gitleaks": "npx tsx src/test2/report/generate-report.ts",
    "test:with-report": "npm run test:gitleaks || true && npm run report:gitleaks",
    "deploy": "vsce publish"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.5",
    "@vscode/vsce": "^3.9.1",
    "@jest/globals": "30.2.0",
    "@types/jest": "30.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "22.x",
    "@types/pdfmake": "0.3.2",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "8.45.0",
    "@typescript-eslint/parser": "8.45.0",
    "@vscode/codicons": "0.0.44",
    "@vscode/test-cli": "0.0.11",
    "@vscode/test-electron": "2.5.2",
    "eslint": "9.36.0",
    "jest": "30.2.0",
    "mocha-junit-reporter": "2.2.1",
    "mocha-multi-reporters": "1.5.1",
    "mochawesome": "7.1.4",
    "mochawesome-merge": "5.1.1",
    "mochawesome-report-generator": "6.3.2",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pdfkit": "0.18.0",
    "pdfmake": "0.3.7"
  }
}