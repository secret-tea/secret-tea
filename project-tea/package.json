{
  "name": "project-tea",
  "displayName": "Project Tea",
	"publisher": "SecretTea",
  "description": "Scan your workspace for secrets!",
  "version": "0.0.2",
	"icon": "icon.png",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "project-tea.helloWorld",
        "title": "Hello World"
      },
			{
        "command": "project-tea.scanCurrentFile",
        "category": "Tea",
        "title": "Scan the current file for secrets"
      },
			{
        "command": "project-tea.scanCurrentWorkspace",
        "category": "Tea",
        "title": "Scan the current workspace for secrets"
      },
			{
        "command": "project-tea.scanRepoHistory",
        "category": "Tea",
        "title": "Scan the entire repo's history for secrets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.104.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
